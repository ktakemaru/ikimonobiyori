{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ikimono-site-catalog/1",
  "title": "ikimono-site-catalog/1",
  "description": "名所カタログ(ikimonobiyori/data/catalog/<subject>.yaml。対象ごとに1ファイル)。docs/design.md §5。段階13 で作成。迷った項目は任意項目にした(後から必須にするほうが易しい)。形だけを見る。位置の粗さの下限・座標の桁・日付の妥当性・id の重複などは ikimonobiyori/catalog.py の検査器が見る。",
  "type": "object",
  "required": ["schema", "subject", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "ikimono-site-catalog/1"},
    "subject": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "このファイルの対象(プロファイルの profile_id。ファイル名と同じ)"},
    "note": {"type": "string"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "url": {"type": "string", "pattern": "^https?://[^\\s]+$"},
    "month_day": {"type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$", "description": "例年の日付(MM-DD)。年をまたぐ時期は start > end で表す"},
    "source": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": {"$ref": "#/$defs/url"},
        "title": {"type": "string"},
        "checked_on": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "人または Claude Code がページを読んだ日"}
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "name", "subjects", "timing_type", "kind", "location_precision", "status", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$", "description": "例: kouyou-0001"},
        "name": {"type": "string", "minLength": 1},
        "example": {"type": "boolean", "description": "true は実在しない説明用の例。approved にできない(検査器)"},
        "subjects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "timing_type": {"enum": ["temperature", "calendar", "managed", "frequency", "episodic"], "description": "時期の型(docs/design.md §3)。同じ対象でも名所によって違うことがある"},
        "species": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "kind": {"enum": ["point", "area", "river", "coast"]},
        "point": {
          "type": "object",
          "required": ["lat", "lon"],
          "additionalProperties": false,
          "properties": {
            "lat": {"type": "number", "minimum": -90, "maximum": 90},
            "lon": {"type": "number", "minimum": -180, "maximum": 180},
            "elevation_m": {"type": ["number", "null"], "description": "見る場所の標高(山頂ではない)。不明は null"}
          }
        },
        "location_precision": {"enum": ["exact", "area_1km", "area_10km"], "description": "対象ごとの下限より細かい値は検査器が拒否する(data/catalog/policy.yaml)"},
        "sensitive": {"type": "boolean", "description": "希少種・生息地など、位置を粗くすべき件。true なら policy の sensitive_min_location_precision 以上(公開会場の例外なし)"},
        "public_venue": {
          "type": "object",
          "required": ["source_url"],
          "additionalProperties": false,
          "description": "公式に公開された観賞会場。policy で例外を許す対象に限り、下限より細かい位置(exact など)を許す",
          "properties": {"source_url": {"$ref": "#/$defs/url"}, "note": {"type": "string"}}
        },
        "typical_window": {
          "type": "object",
          "required": ["start", "end", "source_url"],
          "additionalProperties": false,
          "description": "例年の時期。出典(source_url)のない値は許さない",
          "properties": {
            "start": {"$ref": "#/$defs/month_day"},
            "end": {"$ref": "#/$defs/month_day"},
            "source_url": {"$ref": "#/$defs/url"},
            "note": {"type": "string"}
          }
        },
        "official_status_url": {"$ref": "#/$defs/url", "description": "今年の状況の公式ページ(人が見る)"},
        "tags": {"type": "object", "additionalProperties": false, "description": "質問の型②どこで・④どんな場所で に答えるための条件(段階16 B-3)。分かる範囲で付け、分からないものは付けない。regions.yaml の prefectures・areas と対応", "properties": {"prefecture": {"type": "string", "pattern": "^.+[都道府県]$"}, "area": {"type": "string", "minLength": 1, "description": "地域の呼び名(例: 日光・箱根・富士五湖・都心)"}, "terrain": {"type": "array", "uniqueItems": true, "items": {"enum": ["mountain", "highland", "lake", "urban", "valley", "waterfall", "garden", "wetland", "river", "coast", "temple_shrine"]}}, "access": {"type": "array", "uniqueItems": true, "items": {"enum": ["ropeway", "cable_car", "walk_from_station", "bus", "car_only"]}}, "traffic_note": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1, "description": "どう付けたか(推定なら推定と書く)"}}}, "status_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$"}, "description": "現況などを発信する公式ページの台帳(data/sources/<subject>.yaml)の id(段階15)。台帳の covers と一致すること(ikimonobiyori/sources.py の検査器)"},
        "description": {"type": "string", "description": "人が承認した短い解説。sources と approved_at がそろったものだけを提案に使う(catalog.usable_description)"},
        "access_notes": {"type": "string"},
        "manners": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "site_ref": {"type": "string", "pattern": "^(yamabiyori|hoshibiyori|ikimonobiyori):[A-Za-z0-9_-]+$", "description": "他のビヨリの地点への参照(例: yamabiyori:m012)"},
        "status": {"enum": ["candidate", "approved", "retired"]},
        "approved_at": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "ユーザーが approved にした日。status: approved なら必須"},
        "retired_at": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "retired_reason": {"type": "string"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}, "description": "出典(公式ページなど)。candidate を作るときから必須"},
        "note": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]}, "then": {"required": ["approved_at"]}}
      ]
    }
  }
}
